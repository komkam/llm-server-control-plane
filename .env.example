# Machine-local configuration and secrets. Copy to /opt/llm-server/.env, mode 0600.
# Never commit the real .env file.
TZ=Asia/Taipei

# Dashboard listener and login. The four DASHBOARD_AUTH values are generated by install.sh.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7000
DASHBOARD_HEALTH_URL=http://127.0.0.1:7000/api/health
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_SCRYPT=GENERATE_AT_INSTALL
DASHBOARD_PASSWORD_SALT=GENERATE_AT_INSTALL
DASHBOARD_SESSION_SECRET=GENERATE_AT_INSTALL

# Grafana
GRAFANA_ADMIN_USER=control-plane
GRAFANA_ADMIN_PASSWORD=GENERATE_AT_INSTALL

# Local Open WebUI connection
OPENAI_API_KEY=local-llm
OPENWEBUI_IMAGE=llm-server/open-webui:security-patched

# Optional integrations. Leave blank when unused.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_SFTP_COMMAND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SOPS_AGE_KEY=
