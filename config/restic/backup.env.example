# Copy to config/restic/backup.env (mode 0600, root-owned) and set the remote repository.
# Examples: sftp:user@backup-host:/srv/restic/llm-server
#           s3:s3.example.net/llm-server-control-plane
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/llm-server/config/restic/password
# RESTIC_SFTP_COMMAND=ssh -i /opt/llm-server/config/restic/id_ed25519
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
