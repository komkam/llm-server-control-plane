[Unit]
Description=Update DuckDNS public IP address
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/opt/llm-server/.env
ExecStart=/usr/local/sbin/duckdns-update
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
