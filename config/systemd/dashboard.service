[Unit]
Description=AI Server Dashboard
After=network.target


[Service]

Type=simple

User=dashboard-agent
Group=dashboard-agent

WorkingDirectory=/opt/llm-server/apps/dashboard

ExecStart=/opt/llm-server/venv/bin/python app.py
Environment=DASHBOARD_HOST=127.0.0.1
EnvironmentFile=-/etc/llm-server/runtime.env

Restart=always

RestartSec=5
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/llm-server/apps/dashboard/data



[Install]

WantedBy=multi-user.target
