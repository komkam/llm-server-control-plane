[Unit]
Description=LLM Server Docker Prometheus Exporter
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Environment=METRICS_HOST=172.17.0.1
Environment=METRICS_PORT=9402
ExecStart=/opt/llm-server/venv/bin/python /opt/llm-server/services/docker_exporter.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
